APP_ENV=development
DATABASE_URL=mssql+pyodbc://sa:YourPassword123!@localhost:1433/wms?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Production configuration is generated from deploy/env.template, see docs/deployment.md
# Logs: text (development) or json; OpenTelemetry export is off unless an OTLP/HTTP endpoint is set
LOG_FORMAT=text
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# AI assistant: off unless a provider is set (anthropic / bedrock / vertex); see docs/deployment.md "AI assistant"
AI_PROVIDER=
# ANTHROPIC_API_KEY=
