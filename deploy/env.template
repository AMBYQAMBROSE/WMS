# WMS deployment settings (install.sh generates .env from this template; values like __xxx__ are filled in by the script)
# After editing, run docker compose up -d to apply the settings before running bash scripts/status.sh.

# ---- Version and project ----
WMS_VERSION=__VERSION__
# Use different names when installing several instances on one server (e.g. test + production)
COMPOSE_PROJECT_NAME=__PROJECT__
# Port used by browsers and PDAs
HTTP_PORT=__HTTP_PORT__
TZ=Asia/Shanghai

# ---- Database ----
# bundled-db: use the bundled SQL Server container; empty: use the customer's own SQL Server (set DATABASE_URL below)
COMPOSE_PROFILES=__PROFILES__
MSSQL_SA_PASSWORD=__SA_PASSWORD__
MSSQL_PID=__MSSQL_PID__
DATABASE_URL=__DATABASE_URL__
# Backup directory, a path **on the database server** (for the bundled database, backups/ under the install directory)
BACKUP_DIR=__BACKUP_DIR__

# ---- Security ----
JWT_SECRET_KEY=__JWT_SECRET__
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENABLE_API_DOCS=true
# The web console uses a same-origin reverse proxy and needs no CORS; set this only when systems on other domains call the API directly
CORS_ALLOW_ORIGINS=[]

# ---- Reports and integrations ----
# Reports split "a day" in this time zone
BUSINESS_TIMEZONE=Asia/Shanghai
# Days to keep successful push logs; failed ones are kept until handled manually
INTEGRATION_RETENTION_DAYS=90

# ---- Logs and monitoring ----
# json: one JSON object per line (with request id, user and duration), for log collectors; text: human-readable
LOG_FORMAT=json
# Requests at least this slow (milliseconds) are logged as warnings
SLOW_REQUEST_MS=1000
# OpenTelemetry: set to the customer's OTLP/HTTP collector to push traces and metrics, e.g. http://otel-collector:4318
# (Grafana Alloy/Tempo, Jaeger, Elastic APM, Datadog Agent, ... all accept OTLP). Empty: nothing is sent.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=wms-backend

# ---- Performance ----
# Number of backend worker processes, usually the CPU core count
WEB_CONCURRENCY=2

# ---- Initialization (first install only) ----
SEED_TENANT_CODE=__TENANT_CODE__
SEED_TENANT_NAME=__TENANT_NAME__
SEED_PRESET=__PRESET__
